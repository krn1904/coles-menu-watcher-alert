# Supabase frontend config (safe to expose — these are the public "anon" credentials)
# Copy this file to .env.local and fill in the anon public key from:
# Supabase Dashboard → Project Settings → API → "anon public"
VITE_SUPABASE_URL=https://cbexfvwjxvwcnorbpjkg.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# ---------------------------------------------------------------------------
# Edge Function secrets (set with: supabase secrets set --env-file supabase/.env.local)
# These are NOT frontend vars; they only matter to the scraper/email functions.
# ---------------------------------------------------------------------------
# Both Coles and Woolworths block datacenter IPs (Supabase Edge + GitHub Actions),
# so automated scraping needs an AU-geolocated proxy. The value is a template:
# {url} is replaced with the (encoded) target URL, and {session} (if present)
# with a sticky-session id so cookie priming survives across requests.
#
# ScraperAPI example (AU geotargeting requires a plan that supports country_code):
#   SCRAPER_PROXY_URL=https://api.scraperapi.com/?api_key=YOUR_KEY&country_code=au&keep_headers=true&url={url}
# ScrapingBee example:
#   SCRAPER_PROXY_URL=https://app.scrapingbee.com/api/v1/?api_key=YOUR_KEY&forward_headers=true&country_code=au&url={url}
SCRAPER_PROXY_URL=

# Optional: cap how many 36-item pages of Woolworths half-price specials to pull
# (keeps proxy credit usage predictable). Default 15 (~540 deals).
WOW_MAX_PAGES=15

# Coles half-price pagination (HTML pages, ~48 products/page after page 1).
# Default 25 pages (~1,200 products). Add a small delay to reduce anti-bot blocks.
COLES_MAX_PAGES=25
COLES_PAGE_DELAY_MS=250
MIN_COLES_DEALS=40

# GitHub Actions secrets (Settings → Secrets → Actions) — required for automated scraping:
#   SUPABASE_ANON_KEY          — triggers email alert edge function
#   SUPABASE_SERVICE_ROLE_KEY  — lets Node scrapers write to deals
#   SCRAPER_PROXY_URL          — AU-geolocated proxy (see above)
